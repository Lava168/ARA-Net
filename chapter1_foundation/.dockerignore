# Exclude large or unnecessary files from Docker build
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.git/
.gitignore
*.md
!chapter1_foundation/README.md

# Experiment results (too large; mount at runtime if needed)
chapter1_foundation/experiment_results*/
chapter1_foundation/archive/
chapter1_foundation/pretrained*/
*.pth

# Data (mount at runtime)
sample_data/

# Logs
chapter1_foundation/logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
